{
  "name": "nodeloki",
  "version": "1.0.0",
  "description": "Visual Node Builder App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.nodeloki.app",
    "productName": "NodeLoki",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "frontend/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}