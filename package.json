{
  "name": "nodeloki",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "appId": "com.nodeloki.app",
    "productName": "NodeLoki",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "frontend/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"]
    }
  }
}